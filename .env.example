# ──────────────────────────────────────────────────────────────────────────────
# Bagnetchon — Order-to-Invoice automation
# Copy this file to `.env` for local reference, but the LIVE values must be set
# inside n8n itself: Settings → Variables (for non-secret flags) and Credentials
# (for OAuth secrets). DO NOT commit a real .env.
# ──────────────────────────────────────────────────────────────────────────────

# ===== Zoho OAuth (Self Client / server-to-server) =====
# Generated in Zoho API Console → Self Client. See README "Zoho OAuth setup".
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# ===== Zoho org / data-center base URL =====
# Found in Zoho Invoice → Settings → Organization Profile (right side panel).
ZOHO_ORG_ID=your_org_id_here

# Default to the .com data center. Change suffix if your Zoho account lives in
# a different region (e.g. https://www.zohoapis.eu/invoice/v3,
# https://www.zohoapis.in/invoice/v3, https://www.zohoapis.com.au/invoice/v3).
ZOHO_BASE_URL=https://www.zohoapis.com/invoice/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# ===== Google Sheet wiring =====
# The Form-linked spreadsheet ID (from the sheet URL).
GS_SPREADSHEET_ID=your_spreadsheet_id_here
# Tab names — change only if you rename them in the sheet.
GS_RESPONSES_SHEET=Form Responses 1
GS_ITEM_CONFIG_SHEET=item_config
# Column letter pair on the responses tab to write back invoice id + status.
# (See README "Sheet write-back columns".)
GS_WRITEBACK_INVOICE_ID_COL=Invoice ID
GS_WRITEBACK_STATUS_COL=Sync Status

# ===== Behavior flags =====
# Notification channel: slack | email
NOTIFY_CHANNEL=slack
NOTIFY_SLACK_WEBHOOK=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Leave AUTO_FINALIZE=false in v1. Do NOT flip without explicit approval —
# flipping it converts draft invoices into finalized ones (irreversible).
AUTO_FINALIZE=false
