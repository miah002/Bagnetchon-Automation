    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Load item_config emits one item PER config row (16 rows).\n// The order must continue as a SINGLE item or every downstream node\n// (incl. Create Contact / Create Draft Invoice) runs once per row.\n// Config rows stay available via $('Load item_config').all() in\n// Build Line Items, so we just collapse back to the single order here.\nreturn [{ json: $('Validate Payload').item.json }];"
      },
      "id": "single-order-node-0001",
